# Copy this file to .env and fill in your values.
# Usage: node --env-file=.env download.js <startPage> <totalPages> <initialKey>

# Base URL of the API (required)
BASE_URL=https://data.source

# Registered device id, sent as id_dispositivo (required). Keep any "=" characters as-is.
DEVICE_ID=YOUR_DEVICE_ID

# Directory where games-XXXX.json files are written (optional, defaults to ".")
OUTPUT_DIR=./output
