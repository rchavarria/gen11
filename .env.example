# Copy this file to .env and fill in your values.
# Usage: node --env-file=.env download.js <startPage> <totalPages>
#        node --env-file=.env download-scores.js

# Base URL of the API (required)
BASE_URL=https://data.source

# Registered device id, sent as id_dispositivo (required). Keep any "=" characters as-is.
DEVICE_ID=YOUR_DEVICE_ID

# Key sent as `key` (required). Keep any "=" characters as-is.
# download.js: initial key only (it rotates with every response).
# download-scores.js: the same key is used for every request.
KEY=YOUR_KEY

# Directory where the downloaded JSON files are written (optional, defaults to ".")
OUTPUT_DIR=./output
